    { "id": "impeccable", "kind": "plugin", "label": "플러그인 impeccable (화면 점검)", "plugin": "impeccable@impeccable", "requiredFor": ["frontend", "design"], "default": true },
    { "id": "claude-mem", "kind": "plugin", "label": "플러그인 claude-mem (대화 기억 검색)", "plugin": "claude-mem@thedotmack", "requiredFor": [], "default": true },
    { "id": "prompts.chat", "kind": "plugin", "label": "플러그인 prompts.chat (프롬프트 모음)", "plugin": "prompts.chat@prompts.chat", "requiredFor": [], "default": true }
