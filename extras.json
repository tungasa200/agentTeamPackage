      "check": [{ "path": "~/.claude/skills/graphify/SKILL.md" }],
      "install": [["py", "-3", "-m", "pipx", "install", "graphifyy"], ["~/.local/bin/graphify.exe", "install", "--platform", "windows"]],
      "requiredFor": [], "default": true
    },
    {
      "id": "headroom", "kind": "mcp", "label": "headroom MCP (컨텍스트 압축)",
      "source": "PyPI headroom-ai",
      "needs": ["pipx"],
      "check": [{ "mcp": "headroom" }],
